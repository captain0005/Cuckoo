# Root example. Copy the service-specific files when running locally:
# - frontend/.env.local.example -> frontend/.env.local
# - backend/.env.example -> backend/.env
# - ai-service/.env.example -> ai-service/.env

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080

# Backend
SERVER_ADDR=127.0.0.1:8080
AI_SERVICE_URL=http://127.0.0.1:9000
DATABASE_DRIVER=sqlite
DATABASE_DSN=data/cuckoo.db
FRONTEND_ORIGIN=http://127.0.0.1:3000

# AI service
TRANSLATOR_PROVIDER=mock
SOURCE_LANGUAGE=zh
TARGET_LANGUAGE=en
OCR_ENGINE=paddle
OCR_LANG=ch
INPAINT_ENGINE=lama
LAMA_MAX_PIXELS=350000
LAMA_MIN_AVAILABLE_MB=1600
