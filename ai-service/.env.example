APP_NAME=Cuckoo

# mock | openai | deepl
TRANSLATOR_PROVIDER=mock
SOURCE_LANGUAGE=zh
TARGET_LANGUAGE=en

# OpenAI-compatible translation API, for example 302.ai Qwen-MT.
TRANSLATE_ENDPOINT=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=qwen-mt-plus
TRANSLATE_TIMEOUT_SECONDS=45

# DeepL.
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# OCR.
OCR_ENGINE=paddle
OCR_LANG=ch
OCR_MIN_CONFIDENCE=0.55
PADDLE_TEXT_DETECTION_MODEL=PP-OCRv5_mobile_det
PADDLE_TEXT_RECOGNITION_MODEL=PP-OCRv5_mobile_rec

# Inpainting. Use lama for high-quality image repair; install requirements-lama.txt.
INPAINT_ENGINE=lama
LAMA_MODEL_PATH=
# Server startup can download big-lama.pt to LAMA_MODEL_PATH when this URL is set.
LAMA_MODEL_URL=
LAMA_DEVICE=auto
LAMA_MAX_PIXELS=350000
LAMA_MIN_AVAILABLE_MB=1600
LAMA_TORCH_THREADS=1
