SERVER_ADDR=127.0.0.1:8080
AI_SERVICE_URL=http://127.0.0.1:9000
DATA_DIR=data
MAX_BATCH_SIZE=30
MAX_UPLOAD_MB=30
FRONTEND_ORIGIN=http://127.0.0.1:3000

# sqlite | postgres. Leave DATABASE_DRIVER and DATABASE_DSN empty to auto-build a Supabase
# PostgreSQL DSN from SUPABASE_PROJECT_REF + SUPABASE_DB_PASSWORD.
DATABASE_DRIVER=sqlite
DATABASE_DSN=data/cuckoo.db
ADMIN_TOKEN_SECRET=change-this-local-admin-secret

# Supabase PostgreSQL direct connection:
# SUPABASE_PROJECT_REF=hjfquoszhwxuxispydev
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_SSLMODE=require
#
# Supabase PostgreSQL full DSN override:
# DATABASE_DRIVER=postgres
# DATABASE_DSN=postgres://postgres:password@db.project.supabase.co:5432/postgres?sslmode=require
